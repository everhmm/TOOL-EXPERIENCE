            border: 1px solid rgba(255, 255, 255, 0.25);
        }
        .dark .glassmorphism {
            background: rgba(15, 23, 42, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
