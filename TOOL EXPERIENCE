    <script>
        // Inicialización y Cache de Gráficos de Chart.js
        let chartFlow = null;
        let chartAudits = null;
        let countdownValue = 300; // 5 minutos en segundos

        document.addEventListener("DOMContentLoaded", () => {
            lucide.createIcons();
            setInitialTimestamp();
            initCharts();
            startCountdown();
            
            // Cargar Google Charts Visualization de forma asíncrona para la simulación de tuberías de datos
            google.charts.load('current', {'packages':['corechart']});
            google.charts.setOnLoadCallback(fetchRealSheetsMetadata);
        });

        // Controlador Dinámico de Vistas (Ventanería en Cascada / SPA)
        function switchView(viewId) {
            const views = ['home', 'ecb', 'tns'];
            views.forEach(v => {
                const element = document.getElementById(`view-${v}`);
                const navBtn = document.getElementById(`nav-${v}`);
                
                if (v === viewId) {
                    element.classList.remove('hidden');
                    element.classList.add('block');
                    if (navBtn) {
                        navBtn.classList.add('bg-corpBlue-50', 'text-corpBlue-600', 'dark:bg-slate-800', 'dark:text-corpBlue-400');
                        navBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
                    }
                } else {
                    element.classList.add('hidden');
                    element.classList.remove('block');
                    if (navBtn) {
                        navBtn.classList.remove('bg-corpBlue-50', 'text-corpBlue-600', 'dark:bg-slate-800', 'dark:text-corpBlue-400');
                        navBtn.classList.add('text-slate-600', 'dark:text-slate-400');
                    }
                }
            });
        }

        // Sistema Operativo Claro / Oscuro (Dark/Light Engine)
        function toggleDarkMode() {
            document.documentElement.classList.toggle('dark');
        }

        // Configuración y Renderizado de Gráficos (Data Visualization Engine)
        function initCharts() {
            const flowCtx = document.getElementById('chart-flow-evolution').getContext('2d');
            chartFlow = new Chart(flowCtx, {
                type: 'line',
                data: {
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                    datasets: [
                        { label: 'Realized (RE)', data: [4, 6, 9, 11, 14, 14], borderColor: '#14b8a6', backgroundColor: 'rgba(20, 184, 166, 0.05)', fill: true, tension: 0.3 },
                        { label: 'Finished (FI)', data: [1, 3, 4, 6, 9, 12], borderColor: '#3b82f6', backgroundColor: 'transparent', tension: 0.3 },
                        { label: 'Completed (CO)', data: [0, 1, 2, 3, 5, 8], borderColor: '#a855f7', backgroundColor: 'transparent', tension: 0.3 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#94a3b8', font: { size: 11 } } } },
                    scales: {
                        y: { grid: { color: 'rgba(148, 163, 184, 0.1)' }, ticks: { color: '#94a3b8' } },
                        x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                    }
                }
            });

            const auditsCtx = document.getElementById('chart-audits-distribution').getContext('2d');
            chartAudits = new Chart(auditsCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Aprobadas', 'Pendientes', 'Rechazadas'],
                    datasets: [{
                        data: [85, 10, 5],
                        backgroundColor: ['#14b8a6', '#f59e0b', '#ef4444'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { color: '#94a3b8', font: { size: 11 } } } },
                    cutout: '75%'
                }
            });
        }

        // Reloj y Temporizador Loop de Auto-Sincronización (5 minutos)
        function startCountdown() {
            const timerDisplay = document.getElementById('sync-timer');
            setInterval(() => {
                countdownValue--;
                if (countdownValue <= 0) {
                    countdownValue = 300; // Resetear contador a 5 minutos
                    triggerAutomatedRefresh();
                }
                const minutes = Math.floor(countdownValue / 60);
                const seconds = countdownValue % 60;
                timerDisplay.innerText = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            }, 1000);
        }

        function setInitialTimestamp() {
            const now = new Date();
            document.getElementById('sync-timestamp').innerText = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'});
        }

        // Arquitectura de Integración con Google Sheets API / Visualization API
        function fetchRealSheetsMetadata() {
            console.log("Inicializando consulta estructurada con Google Visualization API para orígenes de datos...");
            // Nota de Arquitectura Corporativa: Para conectar las hojas en producción de forma 100% interactiva,
            // cada enlace utiliza los endpoints públicos estructurados de la siguiente forma:
            // https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/gviz/tq?tq=[QUERY_STRING]
            // Ejemplo de ejecución interna simulada por eventos del ecosistema:
            setInitialTimestamp();
        }

        function triggerAutomatedRefresh() {
            console.log("Auto-Sync ejecutado. Refrescando sockets y conexiones con las hojas de cálculo del Drive...");
            setInitialTimestamp();
            
            // Animación reactiva en gráficos al actualizar datos reales
            if(chartFlow && chartAudits) {
                chartFlow.update('active');
                chartAudits.update('active');
            }
        }
    </script>
